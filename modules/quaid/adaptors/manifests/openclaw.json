{
  "schema": "quaid-adapter-install/v1",
  "id": "openclaw",
  "name": "OpenClaw",
  "install": {
    "selectLabel": "OpenClaw",
    "selectHint": "gateway-integrated runtime",
    "compatibilityWarnings": [
      "Platform has been tested primarily on Telegram. TUI interface is known to be unstable."
    ],
    "sortOrder": 20
  },
  "runtime": {
    "instancePrefix": "openclaw-",
    "projectEnvVars": [],
    "deriveInstanceFromCwd": false,
    "supportsProjectDirBinding": false,
    "staleAgentSiloPrune": true,
    "python": {
      "module": "adaptors.openclaw.adapter",
      "class": "OpenClawAdapter"
    }
  },
  "scripts": {
    "preinstall": "./hooks/preinstall.mjs",
    "postinstall": "./hooks/postinstall.mjs"
  }
}
