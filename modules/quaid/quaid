#!/usr/bin/env bash
# quaid - Total Recall memory system CLI
#
# Usage:
#   quaid search "query" --owner quaid
#   quaid store "fact" --owner quaid
#   quaid add-edge "Alice" parent_of "Bob" --owner quaid
#   quaid stats
#   quaid get-edges <node_id>
#   quaid janitor --task all --dry-run
#   quaid docs check
#   quaid registry list --project quaid
#   quaid doctor
#   quaid config  # deprecated; edit config files directly
#   quaid auth refresh [<token>|--file <path>]
#   quaid help
#
# This is a convenience wrapper around the Python modules.

# Platform check — Quaid requires macOS or Linux (uses fcntl, os.fork, AF_UNIX)
case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW*|CYGWIN*|MSYS*|Windows_NT)
    echo "error: Quaid requires macOS or Linux. Windows is not supported." >&2
    exit 1
    ;;
esac

set -euo pipefail

# Resolve symlinks to find the real plugin directory
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CMD="${1:-help}"
shift 2>/dev/null || true

# Ensure adapter config discovery has canonical hidden + visible roots.
if [[ -z "${QUAID_HOME:-}" && -n "${OPENCLAW_WORKSPACE:-}" ]]; then
  export QUAID_HOME="$OPENCLAW_WORKSPACE"
fi
if [[ -z "${OPENCLAW_WORKSPACE:-}" && -n "${QUAID_HOME:-}" ]]; then
  export OPENCLAW_WORKSPACE="$QUAID_HOME"
fi
if [[ -z "${QUAID_VISIBLE_HOME:-}" && -n "${QUAID_HOME:-}" ]]; then
  _qh_base="$(basename "${QUAID_HOME}")"
  if [[ "${_qh_base}" == .* && "${_qh_base}" != "." ]]; then
    export QUAID_VISIBLE_HOME="$(cd "$(dirname "${QUAID_HOME}")" && pwd)/${_qh_base#.}"
  else
    export QUAID_VISIBLE_HOME="$(cd "${QUAID_HOME}" && pwd)"
  fi
fi
if [[ -z "${QUAID_HOME:-}" ]]; then
  ROOT_CANDIDATE="$(cd "$SCRIPT_DIR/../.." && pwd)"
  if [[ -d "$ROOT_CANDIDATE/instances" || -d "$ROOT_CANDIDATE/shared" ]]; then
    export QUAID_HOME="$ROOT_CANDIDATE"
    export OPENCLAW_WORKSPACE="$ROOT_CANDIDATE"
    if [[ -z "${QUAID_VISIBLE_HOME:-}" ]]; then
      _qh_base="$(basename "$ROOT_CANDIDATE")"
      if [[ "${_qh_base}" == .* && "${_qh_base}" != "." ]]; then
        export QUAID_VISIBLE_HOME="$(cd "$(dirname "$ROOT_CANDIDATE")" && pwd)/${_qh_base#.}"
      else
        export QUAID_VISIBLE_HOME="$(cd "$ROOT_CANDIDATE" && pwd)"
      fi
    fi
  fi
fi


# Ensure Python can import Quaid modules when invoked from any cwd.
if [[ -z "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="$SCRIPT_DIR"
elif [[ ":${PYTHONPATH}:" != *":${SCRIPT_DIR}:"* ]]; then
  export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH}"
fi

# Resolve a Python 3.10+ interpreter without trusting PATH order.
# LaunchAgents often resolve "python3" to the macOS system Python 3.9, which
# cannot run Quaid's newer syntax and may not have sqlite-vec installed.
_python_bin_ok() {
  local bin="${1:-}"
  [[ -n "$bin" ]] || return 1
  if [[ "$bin" == */* && ! -x "$bin" ]]; then
    return 1
  fi
  "$bin" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}

_resolve_python_bin() {
  local candidates=()
  [[ -n "${QUAID_PYTHON_BIN:-}" ]] && candidates+=("${QUAID_PYTHON_BIN}")
  candidates+=(
    "/opt/homebrew/bin/python3"
    "/opt/homebrew/bin/python3.13"
    "/opt/homebrew/bin/python3.12"
    "/opt/homebrew/bin/python3.11"
    "/opt/homebrew/bin/python3.10"
    "/usr/local/bin/python3"
    "/usr/local/bin/python3.13"
    "/usr/local/bin/python3.12"
    "/usr/local/bin/python3.11"
    "/usr/local/bin/python3.10"
    "python3.13"
    "python3.12"
    "python3.11"
    "python3.10"
    "python3"
  )
  local candidate=""
  for candidate in "${candidates[@]}"; do
    if _python_bin_ok "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf '%s\n' "${QUAID_PYTHON_BIN:-python3}"
}

PYTHON_BIN="$(_resolve_python_bin)"
export QUAID_PYTHON_BIN="$PYTHON_BIN"

_derive_openclaw_agent_instance_from_cwd() {
  local cfg_path="${OPENCLAW_CONFIG_PATH:-$HOME/.openclaw/openclaw.json}"
  [[ -f "$cfg_path" ]] || return 0
  "$PYTHON_BIN" - "$PWD" "$cfg_path" "${QUAID_INSTANCE:-}" <<'PYEOF'
import json
import pathlib
import sys

cwd = pathlib.Path(sys.argv[1]).resolve()
cfg_path = pathlib.Path(sys.argv[2]).expanduser()
current_instance = str(sys.argv[3] if len(sys.argv) > 3 else "").strip()

try:
    data = json.loads(cfg_path.read_text())
except Exception:
    raise SystemExit(0)

agents = (data.get("agents") or {}).get("list") or []
prefix = "openclaw"
if current_instance.startswith("openclaw-"):
    prefix = "openclaw"
elif current_instance.startswith("openclaw"):
    prefix = current_instance

for agent in agents:
    if not isinstance(agent, dict):
        continue
    label = str(agent.get("id") or "").strip().lower()
    if not label or label == "main":
        continue
    for key in ("workspace", "agentDir"):
        raw = str(agent.get(key) or "").strip()
        if not raw:
            continue
        try:
            candidate = pathlib.Path(raw).expanduser().resolve()
        except Exception:
            continue
        if cwd == candidate or candidate in cwd.parents:
            print(f"{prefix}-{label}")
            raise SystemExit(0)
PYEOF
}

if [[ -n "${QUAID_HOME:-}" || -n "${OPENCLAW_WORKSPACE:-}" ]]; then
  _oc_agent_instance="$(_derive_openclaw_agent_instance_from_cwd || true)"
  if [[ -n "$_oc_agent_instance" && "${QUAID_INSTANCE:-}" != "$_oc_agent_instance" ]]; then
    export QUAID_INSTANCE="$_oc_agent_instance"
  fi
fi

case "$CMD" in
  # Lifecycle hooks (adapter-agnostic)
  hook-inject)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/interface/hooks.py" inject "$@"
    ;;
  hook-inject-compact)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/interface/hooks.py" inject-compact "$@"
    ;;
  hook-extract)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/interface/hooks.py" extract "$@"
    ;;
  hook-session-init)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/interface/hooks.py" session-init "$@"
    ;;
  hook-codex-stop)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/interface/hooks.py" codex-stop "$@"
    ;;
  hook-subagent-start)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/interface/hooks.py" subagent-start "$@"
    ;;
  hook-subagent-stop)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/interface/hooks.py" subagent-stop "$@"
    ;;

  auth)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/auth_cli.py" "$@"
    ;;

  # Extraction daemon
  daemon)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/extraction_daemon.py" "$@"
    ;;

  # Janitor commands
  janitor)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/lifecycle/janitor.py" "$@"
    ;;

  # Domain management
  domain)
    SUBCMD="${1:-list}"
    shift 2>/dev/null || true
    case "$SUBCMD" in
      list)     exec "$PYTHON_BIN" -c "
import sys; sys.path.insert(0, '$SCRIPT_DIR')
from core.interface.api import list_domains
import json
print(json.dumps(list_domains(), indent=2))
" "$@" ;;
      register) exec "$PYTHON_BIN" -c "
import sys; sys.path.insert(0, '$SCRIPT_DIR')
from core.interface.api import register_domain
import json
name = sys.argv[1] if len(sys.argv) > 1 else ''
desc = sys.argv[2] if len(sys.argv) > 2 else ''
if not name:
    print('Usage: quaid domain register <name> [description]', file=sys.stderr)
    sys.exit(1)
print(json.dumps(register_domain(name, desc), indent=2))
" "$@" ;;
      *)        echo "Usage: quaid domain {list|register <name> [description]}"; exit 1 ;;
    esac
    ;;

  # Docs subsystem
  docs)
    SUBCMD="${1:-help}"
    shift 2>/dev/null || true
    case "$SUBCMD" in
      list)    exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/docsdb/registry.py" list "$@" ;;
      check)   exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/docsdb/updater.py" check "$@" ;;
      update)  exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/docsdb/updater.py" update-stale "$@" ;;
      changelog) exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/docsdb/updater.py" changelog "$@" ;;
      *)       echo "Usage: quaid docs {list|check|update|changelog} [args...]"; exit 1 ;;
    esac
    ;;

  # Registry/projects subsystem (docs registry)
  registry)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/docsdb/registry.py" "$@"
    ;;

  # Project system (project registry, shadow git, sync)
  project|projects)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/project_registry_cli.py" "$@"
    ;;

  # Global project registry (cross-instance tracking)
  global-registry)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/lib/project_registry.py" "$@"
    ;;

  # Project updater
  updater)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/docsdb/project_updater.py" "$@"
    ;;

  # Compatibility check
  compat|compatibility)
    exec "$PYTHON_BIN" -c "
import sys, json; sys.path.insert(0, '$SCRIPT_DIR')
from core.compatibility import (
    read_circuit_breaker, HostInfo, preflight_compatibility_check,
    fetch_compatibility_matrix, evaluate_compatibility, _parse_version,
    NORMAL, DEGRADED, SAFE_MODE,
)
from lib.adapter import get_adapter

subcmd = sys.argv[1] if len(sys.argv) > 1 else 'status'

if subcmd == 'status':
    adapter = get_adapter()
    data_dir = adapter.data_dir()
    breaker = read_circuit_breaker(data_dir)
    info = adapter.get_host_info()
    print(f'Host: {info.label()}')
    print(f'Binary: {info.binary_path or \"unknown\"}')
    print(f'Circuit breaker: {breaker.status}')
    if breaker.message:
        print(f'Message: {breaker.message}')
    if breaker.reason:
        print(f'Reason: {breaker.reason}')
elif subcmd == 'check':
    adapter = get_adapter()
    info = adapter.get_host_info()
    # Read quaid version from package.json
    from pathlib import Path
    pkg = Path('$SCRIPT_DIR') / 'package.json'
    qv = 'unknown'
    if pkg.exists():
        qv = json.loads(pkg.read_text()).get('version', 'unknown')
    result = preflight_compatibility_check(
        info.platform, info.version, qv,
        cache_dir=adapter.data_dir(),
    )
    print(f'Status: {result[\"status\"]}')
    print(f'OK: {result[\"ok\"]}')
    print(f'Message: {result[\"message\"]}')
    if result['fix']:
        print(f'Fix: {result[\"fix\"]}')
elif subcmd == 'matrix':
    adapter = get_adapter()
    matrix = fetch_compatibility_matrix(adapter.data_dir())
    if matrix:
        print(json.dumps(matrix, indent=2))
    else:
        print('No matrix available (fetch failed and no cache)')
        sys.exit(1)
else:
    print('Usage: quaid compat {status|check|matrix}')
    sys.exit(1)
" "$@"
    ;;

  notify)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/core/runtime/notify.py" "$@"
    ;;

# Everything else goes to memory_graph.py
store|stats|recall|get-edges|get-node|delete-node|create-edge|add-edge|delete-edges-by-fact|backfill-hashes|health|event)
    if [[ "$CMD" == "add-edge" ]]; then
      CMD="create-edge"
    fi
    exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/memorydb/memory_graph.py" "$CMD" "$@"
    ;;

  identity-map)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/memorydb/identity_map.py" "$@"
    ;;

  doctor)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/memorydb/memory_graph.py" health "$@"
    ;;

  session)
    echo "error: 'quaid session' is not a public CLI surface" >&2
    echo "session log indexing/loading is internal runtime plumbing" >&2
    exit 1
    ;;

  claudecode|openclaw)
    # Adapter-registered CLI namespace dispatch
    ADAPTER_CMD="$CMD"
    "$PYTHON_BIN" - "$ADAPTER_CMD" "$@" <<'PYEOF'
import sys, os
sys.path.insert(0, os.environ.get("QUAID_MODULE_ROOT", os.path.dirname(os.path.abspath(__file__))))

adapter_ns = sys.argv[1]
subcmd = sys.argv[2] if len(sys.argv) > 2 else ""
rest = sys.argv[3:]

# Instantiate the adapter directly from the namespace rather than reading
# config.json via get_adapter(). This allows commands like make_instance
# to run even when the target silo doesn't have config.json yet.
if adapter_ns == "claudecode":
    from adaptors.claude_code.adapter import ClaudeCodeAdapter
    adapter = ClaudeCodeAdapter()
elif adapter_ns == "openclaw":
    from adaptors.openclaw.adapter import OpenClawAdapter
    adapter = OpenClawAdapter()
else:
    from lib.adapter import get_adapter
    adapter = get_adapter()
ns = adapter.get_cli_namespace()
if ns != adapter_ns:
    print(f"error: adapter namespace '{ns}' does not match '{adapter_ns}'", file=sys.stderr)
    sys.exit(1)

commands = adapter.get_cli_commands()
if not subcmd or subcmd not in commands:
    print(f"Usage: quaid {adapter_ns} <command>")
    print(f"Available commands: {', '.join(commands.keys()) if commands else '(none)'}")
    sys.exit(1 if subcmd else 0)

commands[subcmd](rest)
PYEOF
    ;;

  instances|instance)
    SUBCMD="${1:-list}"
    shift 2>/dev/null || true
    case "$SUBCMD" in
      list)
        "$PYTHON_BIN" - "$@" <<'PYEOF'
import sys, os, json
sys.path.insert(0, os.environ.get("QUAID_MODULE_ROOT", os.path.dirname(os.path.abspath(__file__))))
from lib.instance import list_instances, quaid_home, instance_id as _iid

home = quaid_home()
instances = list_instances()
try:
    current = _iid()
except Exception:
    current = None

if "--json" in sys.argv:
    print(json.dumps({"home": str(home), "current": current, "instances": instances}))
else:
    print(f"Quaid home: {home}")
    print()
    if not instances:
        print("  (no instances found)")
    else:
        for name in instances:
            marker = " *" if name == current else ""
            print(f"  {name}{marker}")
    if current and current not in instances:
        print(f"  {current}  (current — not yet initialised)")
    print()
PYEOF
        ;;
      *)
        echo "Usage: quaid instances list"
        exit 1
        ;;
    esac
    ;;

  config)
    CONFIG_SUBCMD="${1:-}"
    case "$CONFIG_SUBCMD" in
      path)
        shift 2>/dev/null || true
        exec "$PYTHON_BIN" "$SCRIPT_DIR/config_cli.py" path "$@"
        ;;
      set-auth)
        shift 2>/dev/null || true
        exec "$PYTHON_BIN" "$SCRIPT_DIR/config_cli.py" set-auth "$@"
        ;;
    esac

    CONFIG_HOME_HINT="${QUAID_HOME:-$HOME/.quaid}"
    CURRENT_INSTANCE_HINT="${QUAID_INSTANCE:-<instance-id>}"
    echo "error: 'quaid config' is deprecated and disabled." >&2
    echo "" >&2
    echo "Edit layered JSON files directly (recommended with your AI agent):" >&2
    echo "  Global defaults:    ${CONFIG_HOME_HINT}/shared/config/global/config.json" >&2
    echo "  Platform overrides: ${CONFIG_HOME_HINT}/shared/config/<platform>/config.json" >&2
    echo "  Instance overrides: ${CONFIG_HOME_HINT}/instances/${CURRENT_INSTANCE_HINT}/config.json" >&2
    echo "" >&2
    echo "For auth token storage, use: quaid auth refresh <token>" >&2
    echo "TODO(post-launch): rewrite 'quaid config' for nested layered architecture." >&2
    exit 2
    ;;

  update)
    exec node "$SCRIPT_DIR/update-quaid.mjs" "$@"
    ;;

  help|--help|-h)
    echo "quaid - Total Recall memory system"
    echo ""
    echo "Memory commands:"
    echo "  store <text>         Store a fact or note exactly as written"
    echo "  add-edge <subject> <relation> <object>  Create an explicit relationship edge"
    echo "  recall <query>       Recall memories (default: vector + graph)"
    echo "  recall <q> '{...}'   Recall with JSON config (stores, limit, domain_filter, etc.)"
    echo "  stats                Database statistics"
    echo "  health               Knowledge base health metrics"
    echo "  doctor               Alias for health"
    echo "  get-node <id>        Get a specific node"
    echo "  get-edges <id>       Get edges for a node"
    echo "  create-edge ...      Alias: low-level graph edge command"
    echo "  event [subcmd]       Event bus (emit/list/process/capabilities)"
    echo ""
    echo ""
    echo "Domains:"
    echo "  domain list          List knowledge domains"
    echo "  domain register      Register a new domain"
    echo ""
    echo "Maintenance:"
    echo "  janitor [args]       Run janitor pipeline"
    echo "  daemon [cmd]         Extraction daemon (start|stop|status|run)"
    echo "  notify [args]        Active + deferred operator notifications"
    echo ""
    echo "Docs:"
    echo "  docs list            List registered docs"
    echo "  docs check           Check doc staleness"
    echo "  docs update --apply  Update stale docs"
    echo "  docs changelog       View update history"
    echo ""
    echo "Projects:"
    echo "  project list [--names-only]  List registered projects"
    echo "  project create       Create a new project"
    echo "  project show <name>  Show project details"
    echo "  project link <name>  Add current instance to an existing project"
    echo "  project unlink <name> Remove current instance from a project"
    echo "  project delete       Delete a project (unlinks all instances)"
    echo "  project snapshot     Take shadow git snapshot(s)"
      echo "  registry [cmd]       Doc registry CLI"
    echo "  global-registry [cmd] Cross-instance project registry"
    echo "  updater [cmd]        Project event processor"
    echo ""
    echo "Hooks:"
    echo "  hook-inject          Inject memories on user prompt"
    echo "  hook-inject-compact  Re-inject after compaction"
    echo "  hook-extract         Extract knowledge from transcript"
    echo "  hook-session-init    Inject project docs at session start"
    echo "  hook-codex-stop      Queue the latest Codex turn for daemon extraction"
    echo "  hook-subagent-start  Register subagent in registry"
    echo "  hook-subagent-stop   Mark subagent complete in registry"
    echo ""
    echo "Compatibility:"
    echo "  compat status        Show host version and circuit breaker state"
    echo "  compat check         Run compatibility preflight check"
    echo "  compat matrix        Show cached compatibility matrix"
    echo ""
    echo "Updates:"
    echo "  update               Update Quaid from latest release tarball"
    echo "  update --check       Check if a newer release is available"
    echo ""
    echo "Config:"
    echo "  instances list       List all Quaid instances under QUAID_HOME"
    echo ""
    echo "Config (deprecated CLI):"
    echo "  config               Deprecated; edit config files directly"
    echo "  auth refresh         Refresh adapter auth token from arg, file, or stdin"
    echo "  Global config path:  \$QUAID_HOME/shared/config/global/config.json"
    echo "  Platform path:       \$QUAID_HOME/shared/config/<platform>/config.json"
    echo "  Instance path:       \$QUAID_HOME/instances/<instance>/config.json"
    echo "  TODO(post-launch): rewrite 'quaid config' for layered nested architecture"
    echo ""
    echo "Run from: $SCRIPT_DIR"
    ;;

  *)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/datastore/memorydb/memory_graph.py" "$CMD" "$@"
    ;;
esac
